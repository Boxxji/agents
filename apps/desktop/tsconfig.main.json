{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/instrumentation/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
