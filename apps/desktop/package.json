{
  "name": "desktop",
  "version": "1.5.0",
  "description": "Hanzo Agents Desktop App",
  "license": "Apache-2.0",
  "author": "Hanzo AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/agents.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main/src/main/main.js",
  "scripts": {
    "start": "npm run build && npm run build:main && cargo run --release --manifest-path src-tauri/Cargo.toml",
    "build": "vite build",
    "build:main": "tsup src/main/main.ts --format esm --target node22 --out-dir dist/main/src/main --external node-pty --external sqlite3 --external keytar --external better-sqlite3",
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 cargo run --manifest-path src-tauri/Cargo.toml\"",
    "dev:vite": "vite",
    "dev:mcp": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 HANZO_AGENTS_MCP=1 cargo run --manifest-path src-tauri/Cargo.toml\"",
    "type-check": "tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "npm run build && npm run build:main && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "dist": "node scripts/build-dist.js",
    "dist:full": "node scripts/build-dist.js"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "husky": "catalog:",
    "ts-node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wait-on": "catalog:"
  },
  "dependencies": {
    "@hanzo/agents-shared": "workspace:*",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@paper-design/shaders-react": "catalog:",
    "@types/sqlite3": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/xterm": "catalog:",
    "@xyflow/react": "catalog:",
    "ai": "catalog:",
    "keytar": "catalog:",
    "marked": "catalog:",
    "node-pty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "sqlite3": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
